.superpowers/

# nuctl deploy scratch (base64 function-spec blobs left behind by `nuctl deploy`)
nuclio-contents-temp-file-*

# Runtime concept-formation graph dumps (regenerated by critical_point_preprocessor;
# save_dir is a relative path, so the folder lands at whatever cwd the process runs in —
# anchorless pattern matches it at the repo root and under src/concept_creator/)
saved_graphs/

# Neo4j DB dumps (backups, not run artifacts; run_* dirs are still tracked)
experiments/neo4j_backup_*/
